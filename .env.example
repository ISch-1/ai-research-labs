# Copy to .env and fill in. .env is git-ignored.

# Where datasets are cached (default: ./data)
# AIRLAB_DATA_DIR=./data

# Experiment tracking backend: auto | mlflow | json | off
AIRLAB_TRACKING=auto
# Point at the docker-compose MLflow server instead of local ./mlruns
# MLFLOW_TRACKING_URI=http://localhost:5000

# Lab B (LLMs) — only needed from Phase 2 on
# OLLAMA_HOST=http://localhost:11434
# ANTHROPIC_API_KEY=
